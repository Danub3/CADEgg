{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CADEgg Evidence Bundle",
  "description": "知识卡 citation 与本地来源摘录交叉核验后的只读证据对象。verified 只表示引用可解析，不代表工程审批通过。",
  "type": "object",
  "required": ["schema", "scene", "card_version", "status", "citations", "issues"],
  "properties": {
    "schema": { "const": "cadegg-evidence/v1" },
    "scene": { "type": "string", "minLength": 1 },
    "card_version": {
      "type": ["string", "null"],
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": { "enum": ["verified", "refused"] },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "source_version",
          "source_title",
          "excerpt_id",
          "section",
          "page",
          "raw_text",
          "mandatory"
        ],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "source_version": { "type": "string", "minLength": 1 },
          "source_title": { "type": "string" },
          "excerpt_id": { "type": "string", "minLength": 1 },
          "section": { "type": "string", "minLength": 1 },
          "page": { "type": "integer", "minimum": 1 },
          "raw_text": { "type": "string", "minLength": 1 },
          "mandatory": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string" },
          "excerpt_id": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "verified" } } },
      "then": {
        "properties": {
          "card_version": { "type": "string" },
          "citations": { "minItems": 1 },
          "issues": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "refused" } } },
      "then": { "properties": { "issues": { "minItems": 1 } } }
    }
  ],
  "additionalProperties": false
}
