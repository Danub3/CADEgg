    {
      "id": "gb-t-50001-4.0.2",
      "section": "4.0.2 图线用途",
      "page": 19,
      "raw_text": "粗实线（b）：主要可见轮廓线；中粗实线（0.5b）：可见轮廓线、尺寸线；细实线（0.25b）：图例填充线、尺寸界线。",
      "extracted_facts": {
        "bold_solid": "主要可见轮廓线",
        "mid_solid": "可见轮廓线、尺寸线",
        "thin_solid": "尺寸界线、图例填充线"
      }
    },
    {
      "id": "gb-t-50001-4.0.10",
      "section": "4.0.10 图线与文字关系",
      "page": 20,
      "raw_text": "图线不得与文字、数字或符号重叠、混淆，不可避免时，应首先保证文字的清晰。",
      "extracted_facts": {
        "note": "图线不得与文字/数字/符号重叠，优先保证文字清晰"
      }
    },
    {
